{
  "name": "cyoa-game-master",
  "version": "1.1.0",
  "description": "An interactive, text-based Choose-Your-Own-Adventure (CYOA) game powered by AI.",
  "main": "electron.js",
  "scripts": {
    "start": "node_modules\\.bin\\electron .",
    "build:css": "postcss ./index.css -o ./dist/index.css --no-map",
    "build": "shx rm -rf dist && shx mkdir dist && npm run build:css && shx cp index.html sw.js manifest.json metadata.json dist/ && cross-env NODE_ENV=production esbuild index.tsx --bundle --outfile=dist/index.js --jsx=automatic",
    "electron:build": "npm run build && electron-builder",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "electron": "^38.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.9",
    "postcss": "^8.4.38",
    "shx": "^0.3.4",
    "tailwindcss": "^3.4.4"
  },
  "dependencies": {
    "@google/genai": "^1.1.0",
    "@xenova/transformers": "^2.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "vite": "^7.1.4"
  },
  "build": {
    "appId": "com.sanyamsharma.cyoagamemaster",
    "productName": "CYOA Game Master",
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
