{
  "name": "cyoa-game-master",
  "version": "1.2.0",
  "description": "An interactive, text-based Choose-Your-Own-Adventure (CYOA) game powered by AI.",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "postinstall": "node download-models.js",
    "start": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "author": "Your Name",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^28.2.3",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.1.4"
  },
  "dependencies": {
    "@google/genai": "^0.1.0",
    "@xenova/transformers": "^2.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "build": {
    "appId": "com.sanyamsharma.cyoagamemaster",
    "productName": "CYOA Game Master",
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "models/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
