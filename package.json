{
  "name": "cyoa-game-master",
  "version": "1.1.0",
  "description": "An interactive, text-based Choose-Your-Own-Adventure (CYOA) game powered by AI.",
  "main": "electron.js",
  "scripts": {
    "start": "node_modules\\.bin\\electron .",
    "build": "shx rm -rf dist && shx mkdir dist && shx cp index.html sw.js manifest.json metadata.json index.css dist/ && esbuild index.tsx --bundle --outfile=dist/index.js --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\"",
    "electron:build": "npm run build && electron-builder",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.9",
    "shx": "^0.3.4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "@xenova/transformers": "^2.17.2",
    "@google/genai": "^1.16.0"
  },
  "build": {
    "appId": "com.sanyamsharma.cyoagamemaster",
    "productName": "CYOA Game Master",
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}